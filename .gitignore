# Allow only Go source, the module files, README.md, and the license.
# Every other filename is ignored until a rule here says otherwise.
*
!*/
!*.go
!go.mod
!go.sum
!README.md
!CONTRIBUTING.md
!LICENSE
!.gitignore

# Keep this block last. A rule here beats an allow rule above.
# Adding !*.json higher in the file does not re-include these names.
*.json
*.yaml
*.yml
*.toml
*.ini
*.cfg
*.conf
*.env
.env
.env.*
*.pem
*.key
*.p8
*.p12
*.pfx
*.crt
*.cer
*.jks
*.keystore
*.kdbx
*.age
*.ovpn
*.tfvars
*.tfstate
*.sqlite
*.db
*.log
*.bak
*.orig
*.swp
id_rsa
id_rsa.*
id_dsa
id_dsa.*
id_ecdsa
id_ecdsa.*
id_ed25519
id_ed25519.*
*.kubeconfig
.netrc
.npmrc
.pypirc
.htpasswd
config.json
credentials.json
credentials.*
secrets.json
secrets.*
token.json
tokens.json
auth.json
service-account*.json
.DS_Store
